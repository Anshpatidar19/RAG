.sidebar-kb-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  cursor: pointer;
  padding: 0;
}

.sidebar-kb-toggle:hover {
  color: var(--accent);
}

.sidebar-kb-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* --- Main column --- */
.main-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.main-header {
  padding: 16px 24px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.brand {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.brand::before {
  color: var(--accent);
}

/* --- Upload --- */
.upload-panel {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.upload-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 9px 14px;
  background: var(--surface-2);
  border: 1px dashed var(--border-strong);
  border-radius: 6px;
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 12px;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}

.upload-button:hover {
  border-color: var(--accent);
}

.upload-error,
.chat-error,
.document-list-error {
  color: var(--error);
  font-size: 12px;
  font-family: var(--font-mono);
  margin: 0;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.upload-notice {
  color: var(--accent);
  font-size: 12px;
  font-family: var(--font-mono);
  margin: 0;
}

.add-url-wrap {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.add-url-form {
  display: flex;
  gap: 6px;
  min-width: 0;
}

.add-url-status {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  margin: 0;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.add-url-form input {
  flex: 1;
  min-width: 0;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text);
  font-size: 12px;
  padding: 8px 10px;
}

.add-url-form input::placeholder {
  color: var(--text-muted);
}

.add-url-form button {
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
  color: var(--text-secondary);
  font-family: var(--font-mono);
  font-size: 11px;
  padding: 0 12px;
  border-radius: 6px;
  cursor: pointer;
  flex-shrink: 0;
  transition: border-color 0.15s, color 0.15s;
}

.add-url-form button:hover:not(:disabled) {
  border-color: var(--accent);
  color: var(--accent);
}

.add-url-form button:disabled {
  opacity: 0.5;
  cursor: default;
}

/* --- Document list --- */
.document-list-empty {
  color: var(--text-muted);
  font-size: 12px;
  font-style: italic;
}

.document-list ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.document-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.document-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.document-name {
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.document-name-link {
  color: var(--text);
  text-decoration: none;
}

.document-name-link:hover {
  color: var(--accent);
  text-decoration: underline;
}

.document-meta {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.document-actions {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}

.document-actions button {
  background: transparent;
  border: 1px solid var(--border-strong);
  color: var(--text-secondary);
  font-family: var(--font-mono);
  font-size: 10px;
  padding: 4px 8px;
  border-radius: 4px;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}

.document-actions button:hover:not(:disabled) {
  border-color: var(--accent);
  color: var(--accent);
}

.document-actions button:disabled {
  opacity: 0.5;
  cursor: default;
}

/* --- Chat --- */
.chat-panel {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.chat-history {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  max-width: 800px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.chat-empty {
  color: var(--text-muted);
  font-size: 13px;
  font-style: italic;
  margin: auto;
}

.chat-turn {
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: rise 0.2s ease-out;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.chat-question {
  align-self: flex-end;
  max-width: 80%;
  background: var(--accent-dim);
  color: var(--text);
  padding: 8px 14px;
  border-radius: 12px 12px 2px 12px;
  font-size: 14px;
  margin: 0;
}

.chat-answer {
  max-width: 85%;
  line-height: 1.6;
  font-size: 14px;
  margin: 0;
  white-space: pre-wrap;
}

.chat-answer-empty {
  color: var(--text-muted);
  font-style: italic;
}

.chat-thinking {
  display: flex;
  gap: 4px;
  margin: 4px 0;
}

.chat-status {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 4px 0;
}

.chat-status-text {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-muted);
}

.stream-cursor {
  display: inline-block;
  color: var(--accent);
  animation: blink 0.9s step-start infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--text-muted);
  animation: pulse 1.2s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes pulse {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

.chat-sources {
  margin-top: 4px;
}

.chat-sources summary {
  cursor: pointer;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.chat-sources summary:hover {
  color: var(--accent);
}

.chat-sources ul {
  list-style: none;
  margin: 10px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.source-item {
  padding: 8px 10px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.source-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.source-type-badge {
  font-family: var(--font-mono);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 2px 6px;
  border-radius: 4px;
  flex-shrink: 0;
}

.source-type-document {
  background: var(--accent-dim);
  color: var(--accent);
}

.source-type-web {
  background: #3a2f1f;
  color: #d9a95f;
}

.source-filename {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.source-link {
  text-decoration: none;
}

.source-link:hover {
  color: var(--accent);
  text-decoration: underline;
}

.source-page {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-muted);
  flex-shrink: 0;
}

.source-score-bar {
  flex: 1;
  height: 3px;
  background: var(--border);
  border-radius: 2px;
  overflow: hidden;
  min-width: 30px;
}

.source-score-fill {
  display: block;
  height: 100%;
  background: var(--accent);
}

.source-score-value {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--accent);
  flex-shrink: 0;
}

.source-snippet {
  margin: 0;
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* --- Chat input --- */
.chat-input-row {
  display: flex;
  gap: 8px;
  padding: 16px 24px;
  border-top: 1px solid var(--border);
  background: var(--surface);
  max-width: 800px;
  width: 100%;
  margin: 0 auto;
}

.chat-input-row input {
  flex: 1;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text);
  font-size: 14px;
  padding: 10px 12px;
}

.chat-input-row input::placeholder {
  color: var(--text-muted);
}

.chat-input-row input:disabled {
  opacity: 0.6;
}

.chat-input-row button {
  background: var(--accent);
  color: #0f1115;
  border: none;
  border-radius: 6px;
  padding: 10px 18px;
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.15s;
}

.chat-input-row button:disabled {
  opacity: 0.4;
  cursor: default;
}

.chat-input-row button:hover:not(:disabled) {
  opacity: 0.85;
}

.mic-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2) !important;
  color: var(--text-secondary) !important;
  border: 1px solid var(--border-strong) !important;
  border-radius: 6px;
  width: 40px;
  flex-shrink: 0;
  font-size: 15px;
  line-height: 1;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}

.mic-button:hover {
  border-color: var(--accent) !important;
  color: var(--accent) !important;
}

.mic-button.listening {
  border-color: var(--error) !important;
  color: var(--error) !important;
  animation: mic-pulse 1s ease-in-out infinite;
}

.voice-mode-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2) !important;
  color: var(--text-secondary) !important;
  border: 1px solid var(--border-strong) !important;
  border-radius: 6px;
  width: 40px;
  flex-shrink: 0;
  font-size: 15px;
  line-height: 1;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s, background 0.15s;
}

.voice-mode-toggle:hover {
  border-color: var(--accent) !important;
}

.voice-overlay {
  position: absolute;
  inset: 0;
  z-index: 20;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32px;
}

.voice-close {
  position: absolute;
  top: 20px;
  right: 20px;
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
  color: var(--text-secondary);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 15px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s, color 0.15s;
}

.voice-close:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.voice-orb-wrap {
  position: relative;
  width: 180px;
  height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.voice-orb {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--accent), var(--accent-dim));
  transition: transform 0.3s ease;
  animation: orb-breathe 3s ease-in-out infinite;
}

.voice-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid var(--accent);
  opacity: 0;
}

.ring-1 { width: 110px; height: 110px; }
.ring-2 { width: 140px; height: 140px; }
.ring-3 { width: 170px; height: 170px; }

@keyframes orb-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

/* Listening: rings pulse outward rhythmically */
.phase-listening .voice-orb {
  animation: orb-listen 1.2s ease-in-out infinite;
}
.phase-listening .voice-ring {
  animation: ring-pulse 1.8s ease-out infinite;
}
.phase-listening .ring-1 { animation-delay: 0s; }
.phase-listening .ring-2 { animation-delay: 0.3s; }
.phase-listening .ring-3 { animation-delay: 0.6s; }

@keyframes orb-listen {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}

@keyframes ring-pulse {
  0% { transform: scale(0.85); opacity: 0.6; }
  100% { transform: scale(1.35); opacity: 0; }
}

/* Thinking: orb rotates through a subtle gradient shift, rings spin */
.phase-thinking .voice-orb {
  animation: orb-think 1.4s ease-in-out infinite;
}
.phase-thinking .voice-ring {
  opacity: 0.4;
  animation: ring-spin 2.5s linear infinite;
  border-style: dashed;
}
.phase-thinking .ring-2 { animation-direction: reverse; animation-duration: 3.5s; }

@keyframes orb-think {
  0%, 100% { transform: scale(0.92); }
  50% { transform: scale(1.02); }
}

@keyframes ring-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Speaking: rhythmic bounce, like a talking waveform pulse */
.phase-speaking .voice-orb {
  animation: orb-speak 0.5s ease-in-out infinite;
}
.phase-speaking .voice-ring {
  animation: ring-pulse 0.9s ease-out infinite;
  opacity: 0.5;
}
.phase-speaking .ring-1 { animation-delay: 0s; }
.phase-speaking .ring-2 { animation-delay: 0.15s; }
.phase-speaking .ring-3 { animation-delay: 0.3s; }

@keyframes orb-speak {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.18); }
}

.voice-phase-label {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin: 0;
}

.voice-caption {
  max-width: 560px;
  text-align: center;
  color: var(--text);
  font-size: 15px;
  line-height: 1.6;
  padding: 0 24px;
  margin: 0;
  min-height: 1.6em;
}

.voice-mode-toggle.active {
  background: var(--accent-dim) !important;
  border-color: var(--accent) !important;
  color: var(--accent) !important;
}

@keyframes mic-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.chat-answer-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.chat-answer-row .chat-answer {
  flex: 1;
}

.speak-button {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 13px;
  cursor: pointer;
  flex-shrink: 0;
  padding: 2px 4px;
  border-radius: 4px;
  transition: color 0.15s;
}

.speak-button:hover {
  color: var(--accent);
}

.speak-button.speaking {
  color: var(--accent);
}
