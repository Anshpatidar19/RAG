def _ensure_conversation(
    conversation_id: str | None,
    first_message: str,
) -> str:

    if conversation_id:

        return conversation_id

    new_id = str(
        uuid.uuid4()
    )

    title = (
        first_message[:40]
        + (
            "…"
            if len(first_message) > 40
            else ""
        )
    )

    _conversation_repository.create_conversation(
        new_id,
        title,
    )

    return new_id


# ===========================================================================
# Ask endpoint
# ===========================================================================


@app.post(
    "/ask",
    response_model=AskResponse,
)
def ask(
    request: AskRequest,
):

    conversation_id = (
        _ensure_conversation(
            request.conversation_id,
            request.question,
        )
    )

    try:

        result = supervisor.handle(
            request.question,
            history=request.history,
        )

    except genai_errors.ServerError as exc:

        raise HTTPException(
            status_code=503,
            detail=(
                "The AI model is temporarily overloaded. "
                "Please try again in a moment."
            ),
        ) from exc

    except Exception as exc:

        traceback.print_exc()

        raise HTTPException(
            status_code=503,
            detail=(
                "Something went wrong reaching a backend "
                "service. Please try again."
            ),
        ) from exc

    # -----------------------------------------------------------------------
    # Build sources
    # -----------------------------------------------------------------------

    sources: list[
        SourceResponse
    ] = []

    for result_item in (
        result.doc_sources
    ):

        sources.append(
            SourceResponse(
                type="document",
                label=(
                    result_item.source_filename
                ),
                page_number=(
                    result_item.chunk.page_number
                ),
                score=result_item.score,
                text_snippet=(
                    result_item.chunk.text[:200]
                ),
            )
        )

    for web_item in (
        result.web_sources
    ):

        sources.append(
            SourceResponse(
                type="web",
                label=web_item.title,
                url=web_item.url,
                text_snippet=(
                    web_item.snippet[:200]
                ),
            )
        )

    trimmed_sources = (
        sources[
            : settings.max_sources_shown
        ]
    )

    # -----------------------------------------------------------------------
    # Save conversation
    # -----------------------------------------------------------------------

    _conversation_repository.add_message(
        conversation_id,
        "user",
        request.question,
    )

    _conversation_repository.add_message(
        conversation_id,
        "assistant",
        result.text,
        sources=[
            source.model_dump()
            for source in trimmed_sources
        ],
    )

    return AskResponse(
        answer=result.text,
        answerable=result.answerable,
        sources=trimmed_sources,
        conversation_id=conversation_id,
    )


# ===========================================================================
# Streaming Ask endpoint
# ===========================================================================


@app.post(
    "/ask/stream"
)
def ask_stream(
    request: AskRequest,
):

    conversation_id = (
        _ensure_conversation(
            request.conversation_id,
            request.question,
        )
    )

    def event_generator():

        yield (
            "data: "
            + json.dumps(
                {
                    "type": "conversation_id",
                    "conversation_id": (
                        conversation_id
                    ),
                }
            )
            + "\n\n"
        )

        final_text = ""

        final_sources_payload = []

        try:

            for event in supervisor.handle_stream(
                request.question,
                history=request.history,
            ):

                # -----------------------------------------------------------
                # Token event
                # -----------------------------------------------------------

                if event["type"] == "token":

                    final_text += (
                        event["text"]
                    )

                # -----------------------------------------------------------
                # Sources event
                # -----------------------------------------------------------

                if event["type"] == "sources":

                    sources_payload = []

                    # -------------------------------------------------------
                    # Document sources
                    # -------------------------------------------------------

                    for result_item in (
                        event["doc_sources"]
                    ):

                        sources_payload.append(
                            {
                                "type": "document",
                                "label": (
                                    result_item
                                    .source_filename
                                ),
                                "url": None,
                                "page_number": (
                                    result_item
                                    .chunk
                                    .page_number
                                ),
                                "score": (
                                    result_item.score
                                ),
                                "text_snippet": (
                                    result_item
                                    .chunk
                                    .text[:200]
                                ),
                            }
                        )

                    # -------------------------------------------------------
                    # Web sources
                    # -------------------------------------------------------

                    for web_item in (
                        event["web_sources"]
                    ):

                        sources_payload.append(
                            {
                                "type": "web",
                                "label": (
                                    web_item.title
                                ),
                                "url": (
                                    web_item.url
                                ),
                                "page_number": None,
                                "text_snippet": (
                                    web_item
                                    .snippet[:200]
                                ),
                            }
                        )

                    final_sources_payload = (
                        sources_payload[
                            : settings
                            .max_sources_shown
                        ]
                    )

                    payload = {
                        "type": "sources",
                        "sources": (
                            final_sources_payload
                        ),
                        "answerable": (
                            event["answerable"]
                        ),
                    }

                else:

                    payload = event

                yield (
                    "data: "
                    + json.dumps(payload)
                    + "\n\n"
                )

        except genai_errors.ServerError:

            yield (
                "data: "
                + json.dumps(
                    {
                        "type": "error",
                        "message": (
                            "The AI model is temporarily "
                            "overloaded. Please try again "
                            "in a moment."
                        ),
                    }
                )
                + "\n\n"
            )

            return

        except Exception:

            traceback.print_exc()

            yield (
                "data: "
                + json.dumps(
                    {
                        "type": "error",
                        "message": (
                            "Something went wrong reaching "
                            "a backend service. Please try again."
                        ),
                    }
                )
                + "\n\n"
            )

            return

        # -------------------------------------------------------------------
        # Save conversation after stream finishes
        # -------------------------------------------------------------------

        _conversation_repository.add_message(
            conversation_id,
            "user",
            request.question,
        )

        _conversation_repository.add_message(
            conversation_id,
            "assistant",
            final_text,
            sources=final_sources_payload,
        )

    return StreamingResponse(
        event_generator(),
        media_type="text/event-stream",
    )


